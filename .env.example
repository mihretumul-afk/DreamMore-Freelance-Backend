[TEMPLATE]
# Dream More AppWorks — Backend Environment Configuration
# Copy this file to `.env` and adjust values for your local/production setup.
# NEVER commit .env with real credentials to version control.

# ──────────────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────────────
APP_NAME="Dream More AppWorks"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# ──────────────────────────────────────────────────────────────────────
# Database (MySQL for production)
# ──────────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dreammore_appworks
DB_USERNAME=root
DB_PASSWORD=

# ──────────────────────────────────────────────────────────────────────
# Session & Cache
# ──────────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database

# ──────────────────────────────────────────────────────────────────────
# Broadcasting (Laravel Reverb for WebSocket messaging)
# ──────────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=reverb

# Reverb server configuration
REVERB_APP_ID=app-id
REVERB_APP_KEY=app-key
REVERB_APP_SECRET=app-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Frontend Reverb variables (for Vite)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ──────────────────────────────────────────────────────────────────────
# Queue (required for broadcasting events)
# ──────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database

# ──────────────────────────────────────────────────────────────────────
# Filesystem
# ──────────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ──────────────────────────────────────────────────────────────────────
# Mail (optional — used for future email notifications)
# ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@dreammore.app"
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────────────────────────────────────────────────────────────
# Frontend URL (for CORS if needed)
# ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
